generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lake {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String
  rating      Float  @default(0)

  ownerType   String
  fishingType String
  fish        String

  lat Float
  lng Float

  street      String
  city        String
  postalCode  String
  voivodeship String

  area         String
  averageDepth String
  bottomType   String
  waterType    String

  cottages     Boolean @default(false)
  campfire     Boolean @default(false)
  noKill       Boolean @default(false)
  tent         Boolean @default(false)
  parking      Boolean @default(false)
  pier         Boolean @default(false)
  toilet       Boolean @default(false)
  shop         Boolean @default(false)
  nightFishing Boolean @default(false)
  boatRental   Boolean @default(false)

  gearRental   Boolean @default(false)
  shelter      Boolean @default(false)
  coveredSpots Boolean @default(false)
  playground   Boolean @default(false)
  cardPayment  Boolean @default(false)

  priceListText String?
  priceListUrl  String?
  rulesText     String?
  rulesUrl      String?

  isOpenAllDay Boolean @default(false)
  openingHours String?

  contactName    String
  contactPhone   String
  contactEmail   String
  contactWebsite String

  priceList         PriceItem[]
  rules             Rule[]
  fishSpecies       FishSpecies[]
  fishRecords       LakeFishRecord[]
  gearRequirements  LakeGearRequirement[]
  images            LakeImage[]
  favourites        Favourite[]
  ratings           Rating[]
  correctionReports LakeCorrectionReport[]
  catches           FishingCatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([voivodeship])
  @@index([city])
  @@index([ownerType])
  @@index([fishingType])
  @@index([createdAt])
  @@index([ownerType, fishingType])
  @@index([voivodeship, ownerType])
  @@index([voivodeship, fishingType])
}

model LakeCorrectionReport {
  id String @id @default(cuid())

  lakeId String
  lake   Lake   @relation(fields: [lakeId], references: [id], onDelete: Cascade)

  userId    String
  userEmail String?

  category    String
  description String

  status    String  @default("pending")
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lakeId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model PriceItem {
  id     String @id @default(cuid())
  text   String
  lakeId String
  lake   Lake   @relation(fields: [lakeId], references: [id], onDelete: Cascade)

  @@index([lakeId])
}

model Rule {
  id     String @id @default(cuid())
  text   String
  lakeId String
  lake   Lake   @relation(fields: [lakeId], references: [id], onDelete: Cascade)

  @@index([lakeId])
}

model FishSpecies {
  id     String @id @default(cuid())
  name   String
  lakeId String
  lake   Lake   @relation(fields: [lakeId], references: [id], onDelete: Cascade)

  @@index([lakeId])
  @@index([name])
}

model LakeFishRecord {
  id       String @id @default(cuid())
  fishName String
  weightKg Float
  lakeId   String
  lake     Lake   @relation(fields: [lakeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lakeId])
  @@index([fishName])
  @@index([weightKg])
}

model LakeGearRequirement {
  id     String @id @default(cuid())
  text   String
  lakeId String
  lake   Lake   @relation(fields: [lakeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lakeId])
}

model LakeImage {
  id        String  @id @default(cuid())
  url       String
  imagePath String?
  lakeId    String
  lake      Lake    @relation(fields: [lakeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([lakeId])
  @@index([createdAt])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  lakeId    String
  lake      Lake     @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lakeId])
  @@index([lakeId])
  @@index([createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  lakeId    String
  lake      Lake     @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lakeId])
  @@index([lakeId])
  @@index([createdAt])
}

model LakeSubmission {
  id String @id @default(cuid())

  userId String?
  status String  @default("pending")

  name        String
  slug        String
  description String

  ownerType   String
  fishingType String
  fish        String

  lat Float
  lng Float

  street      String
  city        String
  postalCode  String
  voivodeship String

  area         String?
  averageDepth String?
  bottomType   String?
  waterType    String?

  cottages     Boolean @default(false)
  campfire     Boolean @default(false)
  noKill       Boolean @default(false)
  tent         Boolean @default(false)
  parking      Boolean @default(false)
  pier         Boolean @default(false)
  toilet       Boolean @default(false)
  shop         Boolean @default(false)
  nightFishing Boolean @default(false)
  boatRental   Boolean @default(false)

  gearRental   Boolean @default(false)
  shelter      Boolean @default(false)
  coveredSpots Boolean @default(false)
  playground   Boolean @default(false)
  cardPayment  Boolean @default(false)

  priceListText String?
  priceListUrl  String?
  rulesText     String?
  rulesUrl      String?

  isOpenAllDay Boolean @default(false)
  openingHours String?

  contactName    String?
  contactPhone   String?
  contactEmail   String?
  contactWebsite String?

  images           LakeSubmissionImage[]
  fishRecords      LakeSubmissionFishRecord[]
  gearRequirements LakeSubmissionGearRequirement[]

  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([voivodeship])
}

model LakeSubmissionImage {
  id           String   @id @default(cuid())
  submissionId String
  imagePath    String
  url          String
  createdAt    DateTime @default(now())

  submission LakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([createdAt])
}

model LakeSubmissionFishRecord {
  id           String @id @default(cuid())
  fishName     String
  weightKg     Float
  submissionId String
  submission   LakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([fishName])
  @@index([weightKg])
}

model LakeSubmissionGearRequirement {
  id           String @id @default(cuid())
  text         String
  submissionId String
  submission   LakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
}

model UserNotification {
  id String @id @default(cuid())

  userId  String
  title   String
  message String
  href    String?
  type    String  @default("info")
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model FishingGear {
  id     String @id @default(cuid())
  userId String

  name          String
  quantity      Int       @default(1)
  category      String
  brand         String?
  model         String?
  fishingMethod String
  condition     String
  status        String    @default("active")
  price         Float?
  purchaseDate  DateTime?
  note          String?
  isDefault     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([userId, category])
  @@index([userId, status])
}

model TripChecklist {
  id     String @id @default(cuid())
  userId String

  title    String
  tripType String  @default("custom")
  status   String  @default("preparing")
  note     String?

  items TripChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

model TripChecklistItem {
  id          String @id @default(cuid())
  checklistId String

  name        String
  category    String
  quantity    Int     @default(1)
  unit        String?
  isPacked    Boolean @default(false)
  isImportant Boolean @default(false)
  source      String  @default("manual")
  gearId      String?
  note        String?

  checklist TripChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistId])
  @@index([category])
  @@index([isPacked])
  @@index([gearId])
}

model FishingTrip {
  id     String @id @default(cuid())
  userId String

  title    String
  lakeId   String?
  lakeName String?

  tripType String   @default("custom")
  status   String   @default("planned")
  startsAt DateTime
  note     String?

  checklistId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([lakeId])
  @@index([status])
  @@index([startsAt])
  @@index([createdAt])
  @@index([userId, status])
  @@index([userId, startsAt])
  @@index([userId, status, startsAt])
}

model FishingCatch {
  id       String  @id @default(cuid())
  userId   String
  userName String?

  fishName String
  weight   Float?
  length   Float?

  method   String
  bait     String?
  caughtAt DateTime

  lakeId   String?
  lakeName String?
  lake     Lake?   @relation(fields: [lakeId], references: [id], onDelete: SetNull)

  tripId    String?
  tripTitle String?

  imageUrl  String?
  imagePath String?

  note String?

  isPublic      Boolean @default(false)
  rankingStatus String  @default("pending")

  reports FishingCatchReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lakeId])
  @@index([userId])
  @@index([tripId])
  @@index([fishName])
  @@index([rankingStatus])
  @@index([isPublic])
  @@index([caughtAt])
  @@index([createdAt])
  @@index([userId, caughtAt])
  @@index([lakeId, caughtAt])
  @@index([isPublic, rankingStatus])
  @@index([isPublic, rankingStatus, weight])
  @@index([isPublic, rankingStatus, length])
}

model FishingCatchReport {
  id String @id @default(cuid())

  catchId      String
  fishingCatch FishingCatch @relation(fields: [catchId], references: [id], onDelete: Cascade)

  userId    String
  userEmail String?

  reason    String
  status    String  @default("pending")
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([catchId, userId])
  @@index([catchId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Achievement {
  id String @id @default(cuid())

  key         String  @unique
  title       String
  description String
  icon        String?
  category    String  @default("general")

  users UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model UserAchievement {
  id String @id @default(cuid())

  userId        String
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}
